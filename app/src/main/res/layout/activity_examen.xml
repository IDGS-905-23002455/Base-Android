<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CBAED7"
        android:orientation="vertical"
        android:padding="15dp"
    tools:context=".Examen_Parcial1.Examen">

        <LinearLayout
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CBAED7"
            android:orientation="vertical"
            android:padding="10dp">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#9B6DC6"
                android:gravity="center"
                android:text="Calcular Valor de resistencias"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/imgResistencia"
                android:layout_width="170dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:src="@drawable/resistencia"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Spinner
                    android:id="@+id/spinner1"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtValor1"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:background="#FF1F1F"
                    android:gravity="center"
                    android:text="2"
                    android:textStyle="bold"
                    android:textColor="#000000" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Spinner
                    android:id="@+id/spinner2"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtValor2"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:background="#FF1F1F"
                    android:gravity="center"
                    android:text="2"
                    android:textStyle="bold"
                    android:textColor="#000000" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Spinner
                    android:id="@+id/spinner3"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtValor3"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:background="#D89B52"
                    android:gravity="center"
                    android:text="10"
                    android:textStyle="bold"
                    android:textColor="#000000" />

            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tolerancia"
                android:textStyle="bold"
                android:layout_marginTop="15dp" />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbOro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="oro" />

                <RadioButton
                    android:id="@+id/rbPlata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="plata" />

            </RadioGroup>


            <TextView
                android:id="@+id/txtTolerancia"
                android:layout_width="40dp"
                android:layout_height="25dp"
                android:background="#FFD600"
                android:layout_marginStart="80dp"
                android:layout_marginTop="-50dp" />


            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="106dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:background="#B6E214"
                android:text="calcular"
                android:textColor="#000000"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="15dp"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/txtOhm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="valor ohm        220"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMaximo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="valor maximo    231"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMinimo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="valor minimo    209"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>